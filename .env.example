# Conexão via Connection Pooling (Supavisor) - Usada em runtime pela aplicação (Porta 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[SUA-SENHA]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexão direta ao banco (Porta 5432) - Usada pelo Prisma para migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[SUA-SENHA]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Segredo JWT do Supabase (Project Settings > API > JWT Settings > JWT Secret)
SUPABASE_JWT_SECRET="seu-supabase-jwt-secret-aqui"

# Porta do Servidor NestJS
PORT=3000
